{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ascension.github.io/sts2-gateway/continuation-owner-v1/frame.schema.json",
  "title": "sts2-continuation-owner-v1 frame",
  "oneOf": [
    {
      "$ref": "#/$defs/readRequest"
    },
    {
      "$ref": "#/$defs/readResponse"
    },
    {
      "$ref": "#/$defs/claimRequest"
    },
    {
      "$ref": "#/$defs/claimResponse"
    },
    {
      "$ref": "#/$defs/lookupRequest"
    },
    {
      "$ref": "#/$defs/lookupResponse"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "instance_id",
        "instance_incarnation",
        "boot_id",
        "authority_generation",
        "host_fence_id",
        "host_fence_generation",
        "lease_id",
        "lease_epoch",
        "session_id",
        "lease_expires_at_millis"
      ],
      "properties": {
        "deployment_id": {
          "$ref": "#/$defs/uuid"
        },
        "instance_id": {
          "$ref": "#/$defs/uuid"
        },
        "instance_incarnation": {
          "$ref": "#/$defs/uuidV4"
        },
        "boot_id": {
          "$ref": "#/$defs/uuidV4"
        },
        "authority_generation": {
          "$ref": "#/$defs/counter"
        },
        "host_fence_id": {
          "$ref": "#/$defs/uuidV4"
        },
        "host_fence_generation": {
          "$ref": "#/$defs/counter"
        },
        "lease_id": {
          "$ref": "#/$defs/uuidV4"
        },
        "lease_epoch": {
          "$ref": "#/$defs/counter"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "lease_expires_at_millis": {
          "$ref": "#/$defs/counter"
        }
      }
    },
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "frameBase": {
      "type": "object",
      "required": [
        "contract",
        "schema_digest",
        "message_id",
        "correlation_id",
        "actor",
        "auth",
        "kind",
        "payload"
      ],
      "properties": {
        "contract": {
          "const": "sts2-continuation-owner-v1"
        },
        "schema_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64
        },
        "message_id": {
          "$ref": "#/$defs/uuidV4"
        },
        "correlation_id": {
          "$ref": "#/$defs/uuidV4"
        },
        "actor": {
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "principal_id",
            "role"
          ],
          "properties": {
            "principal_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "role": {
              "enum": [
                "harness",
                "gateway"
              ]
            }
          }
        },
        "auth": {
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "principal_id",
            "capability",
            "proof"
          ],
          "properties": {
            "principal_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "capability": {
              "enum": [
                "continuation_owner_read",
                "continuation_owner_claim",
                "continuation_owner_lookup"
              ]
            },
            "proof": {
              "type": "null"
            }
          }
        }
      }
    },
    "readRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/frameBase"
        },
        {
          "type": "object",
          "properties": {
            "actor": {
              "$ref": "#/$defs/harnessActor"
            },
            "auth": {
              "$ref": "#/$defs/readAuth"
            },
            "kind": {
              "const": "current_owner_request"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 0
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "readResponse": {
      "allOf": [
        {
          "$ref": "#/$defs/frameBase"
        },
        {
          "type": "object",
          "properties": {
            "actor": {
              "$ref": "#/$defs/gatewayActor"
            },
            "auth": {
              "$ref": "#/$defs/readAuth"
            },
            "kind": {
              "const": "current_owner_response"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "owner"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "available",
                    "absent",
                    "expired",
                    "revoked",
                    "unknown"
                  ]
                },
                "owner": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/owner"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "claimRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/frameBase"
        },
        {
          "type": "object",
          "properties": {
            "actor": {
              "$ref": "#/$defs/harnessActor"
            },
            "auth": {
              "$ref": "#/$defs/claimAuth"
            },
            "kind": {
              "const": "owner_claim_request"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operation_id",
                "expected_owner"
              ],
              "properties": {
                "operation_id": {
                  "$ref": "#/$defs/uuidV4"
                },
                "expected_owner": {
                  "$ref": "#/$defs/owner"
                }
              }
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "claimResponse": {
      "allOf": [
        {
          "$ref": "#/$defs/frameBase"
        },
        {
          "type": "object",
          "properties": {
            "actor": {
              "$ref": "#/$defs/gatewayActor"
            },
            "auth": {
              "$ref": "#/$defs/claimAuth"
            },
            "kind": {
              "const": "owner_claim_response"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "result",
                "claim"
              ],
              "properties": {
                "result": {
                  "enum": [
                    "CLAIMED",
                    "DUPLICATE"
                  ]
                },
                "claim": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "operation_id",
                    "request_digest",
                    "owner",
                    "claimed_at_millis"
                  ],
                  "properties": {
                    "operation_id": {
                      "$ref": "#/$defs/uuidV4"
                    },
                    "request_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "maxLength": 64
                    },
                    "owner": {
                      "$ref": "#/$defs/owner"
                    },
                    "claimed_at_millis": {
                      "$ref": "#/$defs/counter"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "lookupRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/frameBase"
        },
        {
          "type": "object",
          "properties": {
            "actor": {
              "$ref": "#/$defs/harnessActor"
            },
            "auth": {
              "$ref": "#/$defs/lookupAuth"
            },
            "kind": {
              "const": "owner_claim_lookup_request"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operation_id"
              ],
              "properties": {
                "operation_id": {
                  "$ref": "#/$defs/uuidV4"
                }
              }
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "lookupResponse": {
      "allOf": [
        {
          "$ref": "#/$defs/frameBase"
        },
        {
          "type": "object",
          "properties": {
            "actor": {
              "$ref": "#/$defs/gatewayActor"
            },
            "auth": {
              "$ref": "#/$defs/lookupAuth"
            },
            "kind": {
              "const": "owner_claim_lookup_response"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claim_state",
                "claim",
                "current_owner"
              ],
              "properties": {
                "claim_state": {
                  "enum": [
                    "not_found",
                    "historical"
                  ]
                },
                "claim": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/claim"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "current_owner": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "state",
                    "owner"
                  ],
                  "properties": {
                    "state": {
                      "enum": [
                        "available",
                        "absent",
                        "expired",
                        "revoked",
                        "unknown"
                      ]
                    },
                    "owner": {
                      "oneOf": [
                        {
                          "$ref": "#/$defs/owner"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "request_digest",
        "owner",
        "claimed_at_millis"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/uuidV4"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "claimed_at_millis": {
          "$ref": "#/$defs/counter"
        }
      }
    },
    "harnessActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "role"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "role": {
          "const": "harness"
        }
      }
    },
    "gatewayActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "role"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "role": {
          "const": "gateway"
        }
      }
    },
    "readAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "capability",
        "proof"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "capability": {
          "const": "continuation_owner_read"
        },
        "proof": {
          "type": "null"
        }
      }
    },
    "claimAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "capability",
        "proof"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "capability": {
          "const": "continuation_owner_claim"
        },
        "proof": {
          "type": "null"
        }
      }
    },
    "lookupAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "capability",
        "proof"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "capability": {
          "const": "continuation_owner_lookup"
        },
        "proof": {
          "type": "null"
        }
      }
    }
  }
}
