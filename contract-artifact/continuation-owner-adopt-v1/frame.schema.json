{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ascension.github.io/sts2-gateway/continuation-owner-adopt-v1/frame.schema.json",
  "title": "sts2-continuation-owner-adopt-v1 frame",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "instance_id",
        "instance_incarnation",
        "boot_id",
        "authority_generation",
        "host_fence_id",
        "host_fence_generation",
        "lease_id",
        "lease_epoch",
        "session_id",
        "lease_expires_at_millis"
      ],
      "properties": {
        "deployment_id": { "$ref": "#/$defs/uuid" },
        "instance_id": { "$ref": "#/$defs/uuid" },
        "instance_incarnation": { "$ref": "#/$defs/uuidV4" },
        "boot_id": { "$ref": "#/$defs/uuidV4" },
        "authority_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "host_fence_id": { "$ref": "#/$defs/uuidV4" },
        "host_fence_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "lease_id": { "$ref": "#/$defs/uuidV4" },
        "lease_epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "lease_expires_at_millis": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "request_digest", "owner", "claimed_at_millis"],
      "properties": {
        "operation_id": { "$ref": "#/$defs/uuidV4" },
        "request_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "owner": { "$ref": "#/$defs/owner" },
        "claimed_at_millis": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "recoveryAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "schema_digest", "context", "current_fence"],
      "properties": {
        "contract": { "const": "watchdog-runtime-allocation-v1" },
        "schema_digest": { "const": "ee967a95e79fb2f157ce58d2b6d857de42b75f1f5ebfeb82dd9672e3b0f7670b" },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deployment_id", "instance_id", "instance_incarnation", "boot_id", "authority_generation", "lease_id", "lease_epoch"],
          "properties": {
            "deployment_id": { "$ref": "#/$defs/uuid" },
            "instance_id": { "$ref": "#/$defs/uuid" },
            "instance_incarnation": { "$ref": "#/$defs/uuidV4" },
            "boot_id": { "$ref": "#/$defs/uuidV4" },
            "authority_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "lease_id": { "$ref": "#/$defs/uuidV4" },
            "lease_epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        },
        "current_fence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host_fence_id", "deployment_id", "instance_id", "instance_incarnation", "boot_id", "authority_generation", "fence_generation", "created_at"],
          "properties": {
            "host_fence_id": { "$ref": "#/$defs/uuidV4" },
            "deployment_id": { "$ref": "#/$defs/uuid" },
            "instance_id": { "$ref": "#/$defs/uuid" },
            "instance_incarnation": { "$ref": "#/$defs/uuidV4" },
            "boot_id": { "$ref": "#/$defs/uuidV4" },
            "authority_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "fence_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "created_at": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "frameFields": {
      "type": "object",
      "required": ["contract", "schema_digest", "message_id", "correlation_id", "actor", "auth", "kind", "payload"],
      "properties": {
        "contract": { "const": "sts2-continuation-owner-adopt-v1" },
        "schema_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64 },
        "message_id": { "$ref": "#/$defs/uuidV4" },
        "correlation_id": { "$ref": "#/$defs/uuidV4" },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["principal_id", "role"],
          "properties": {
            "principal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "role": { "type": "string" }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["principal_id", "capability", "proof"],
          "properties": {
            "principal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "capability": { "const": "continuation_owner_adopt" },
            "proof": { "type": "null" }
          }
        }
      }
    },
    "request": {
      "allOf": [
        { "$ref": "#/$defs/frameFields" },
        {
          "type": "object",
          "properties": {
            "actor": {
              "properties": {
                "role": { "const": "harness" }
              }
            },
            "kind": { "const": "owner_adopt_request" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation_id", "expected_owner"],
              "properties": {
                "operation_id": { "$ref": "#/$defs/uuidV4" },
                "expected_owner": { "$ref": "#/$defs/owner" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "response": {
      "allOf": [
        { "$ref": "#/$defs/frameFields" },
        {
          "type": "object",
          "properties": {
            "actor": {
              "type": "object",
              "additionalProperties": false,
              "required": ["principal_id", "role"],
              "properties": {
                "principal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
                "role": { "const": "gateway" }
              }
            },
            "kind": { "const": "owner_adopt_response" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["result", "claim", "owner", "recovery_authority"],
              "properties": {
                "result": { "const": "ADOPTED" },
                "claim": { "$ref": "#/$defs/claim" },
                "owner": { "$ref": "#/$defs/owner" },
                "recovery_authority": { "$ref": "#/$defs/recoveryAuthority" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
